
# ~/.blerc — ble.sh


# Completion

bleopt complete_ambiguous=1
bleopt complete_auto_delay=150
bleopt complete_menu_style=align-nowrap


# Truecolor / 24-bit RGB

# Use 256-colour support as the fallback.
bleopt term_index_colors=256

# Enable 24-bit RGB escape sequences
bleopt term_true_colors=semicolon

# Kbase16 baseline; custom RGB faces override it.
bleopt color_scheme=base16


# Inline suggestions

ble-face -s auto_complete fg=#6c7086,italic


# Syntax highlighting — Catppuccin Mocha-inspired RGB colours

ble-face -s command_builtin       fg=#89b4fa
ble-face -s command_alias         fg=#cba6f7
ble-face -s command_function      fg=#89b4fa
ble-face -s command_file          fg=#a6e3a1
ble-face -s command_keyword       fg=#cba6f7
ble-face -s command_directory     fg=#89b4fa,underline

ble-face -s argument_option       fg=#89dceb
ble-face -s argument_error        fg=#f38ba8,bold

ble-face -s syntax_quotation      fg=#a6e3a1
ble-face -s syntax_expr           fg=#cba6f7
ble-face -s syntax_varname        fg=#f9e2af
ble-face -s syntax_error          fg=#f38ba8,bold
ble-face -s syntax_comment        fg=#6c7086,italic

ble-face -s filename_directory    fg=#89b4fa,bold
ble-face -s filename_link         fg=#94e2d5,underline
ble-face -s filename_executable   fg=#a6e3a1,bold
ble-face -s filename_warning      fg=#f38ba8,bold
ble-face -s filename_url          fg=#89b4fa,underline

# Selected text and matching delimiters
ble-face -s region                fg=#cdd6f4,bg=#45475a
ble-face -s region_match          fg=#cdd6f4,bg=#585b70
ble-face -s region_target         fg=#1e1e2e,bg=#f9e2af,bold


# Cleaner output and execution timing

bleopt prompt_eol_mark=''

# Enable timing for commands using at least 10 seconds of CPU time.
bleopt exec_elapsed_mark=$'\e[94m[%ss]\e[m'
bleopt exec_elapsed_enabled='usr+sys>=10000'


# fzf integration

# Load in the background to keep startup responsive.
ble-import -d integration/fzf-completion
ble-import -d integration/fzf-key-bindings


