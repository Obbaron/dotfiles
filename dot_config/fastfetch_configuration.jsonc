{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/main/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#36}╭───────────╮"
    },
    {
      "type": "title",
      "key": "{#36}│ {#31} user    {#36}│",
      "format": "{1}"
    },
    {
      "type": "title",
      "key": "{#36}│ {#32}󰒋 hname   {#36}│",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": "{#36}│ {#33}󰅐 uptime  {#36}│"
    },
    {
      "type": "os",
      "key": "{#36}│ {#34} distro  {#36}│"
    },
    {
      "type": "kernel",
      "key": "{#36}│ {#35} kernel  {#36}│"
    },
    {
      "type": "terminal",
      "key": "{#36}│ {#31} term    {#36}│"
    },
    {
      "type": "shell",
      "key": "{#36}│ {#32} shell   {#36}│"
    },
    {
      "type": "cpu",
      "key": "{#36}│ {#33} cpu     {#36}│"
    },
    {
      "type": "disk",
      "key": "{#36}│ {#34}󰋊 disk    {#36}│"
    },
    {
      "type": "memory",
      "key": "{#36}│ {#35} memory  {#36}│"
    },
    {
      "type": "localip",
      "key": "{#36}│ {#36}󰩠 network {#36}│",
      "showIpv6": false,
      "showMac": false,
      "showLoop": false
    },
    {
      "type": "custom",
      "format": "{#36}├───────────┤"
    },
    {
      "type": "colors",
      "key": "{#36}│ {#39} colors  {#36}│",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "{#36}╰───────────╯"
    }
  ]
}