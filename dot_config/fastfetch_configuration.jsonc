{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/main/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },

    "display": {
        "separator": "  ",
        "key": {
            "type": "string"
        },
        "color": {
            "keys": "blue"
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "╭────────────────────────────────────────────────────────╮"
        },

        {
            "type": "title",
            "key": "👤 user",
            "format": "{user-name}"
        },
        {
            "type": "host",
            "key": "│ 🏠 hname",
            "format": "{host-name}"
        },
        {
            "type": "uptime",
            "key": "│ ◷ uptime",
            "format": "{days} days, {hours} hours, {minutes} mins"
        },
        {
            "type": "os",
            "key": "│ ♧ distro",
            "format": "{name} {arch}"
        },
        {
            "type": "kernel",
            "key": "│ ⚙ kernel",
            "format": "{release}"
        },
        {
            "type": "terminal",
            "key": "│ ▣ term",
            "format": "{pretty-name}"
        },
        {
            "type": "shell",
            "key": "│ ◫ shell",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "cpu",
            "key": "│ ⚙ cpu",
            "format": "{name} ({cores-physical}+{cores-logical}) @ {frequency-max} GHz"
        },
        {
            "type": "disk",
            "key": "│ ▣ disk",
            "format": "{size-used} / {size-total} ({percentage}) - {filesystem}"
        },
        {
            "type": "memory",
            "key": "│ ▤ memory",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "localip",
            "key": "│ ▣ network",
            "format": "{ipv4-address}/{ipv4-prefix-length} ({interface})"
        },

        {
            "type": "custom",
            "format": "├────────────────────────────────────────────────────────┤"
        },

        {
            "type": "colors",
            "key": "│ ● colors",
            "symbol": "circle"
        },

        {
            "type": "custom",
            "format": "╰────────────────────────────────────────────────────────╯"
        }
    ]
}
